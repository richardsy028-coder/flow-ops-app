<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Clarity FLOW | Operating Companion</title>
<style>
:root{
  --bg:#06110f;
  --card:#17221f;
  --card2:#202c28;
  --text:#f5f7f6;
  --muted:#a7b8b4;
  --line:rgba(255,255,255,.12);
  --cyan:#62eadf;
  --gold:#d9c46a;
}
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:Inter,Arial,sans-serif;
  background:linear-gradient(180deg,#07110f,#030807);
  color:var(--text);
  line-height:1.6;
}
a{text-decoration:none;color:inherit}
.container{width:min(1120px,92%);margin:auto}
header{
  position:sticky;top:0;z-index:10;
  background:rgba(6,17,15,.9);
  border-bottom:1px solid var(--line);
  backdrop-filter:blur(14px);
}
.nav{height:72px;display:flex;align-items:center;justify-content:space-between}
.logo{font-weight:900;letter-spacing:.08em}
.btn{
  display:inline-block;
  padding:13px 18px;
  border-radius:999px;
  border:1px solid var(--line);
  font-weight:800;
  margin:6px 6px 6px 0;
}
.primary{
  background:linear-gradient(135deg,var(--gold),var(--cyan));
  color:#06110f;
  border:none;
}
section{padding:80px 0}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center}
h1{font-size:clamp(42px,7vw,78px);line-height:.95;letter-spacing:-.06em;margin-bottom:22px}
h2{font-size:clamp(32px,5vw,52px);line-height:1;margin-bottom:18px}
h3{margin-bottom:10px}
p{color:var(--muted);font-size:17px}
.badge{
  display:inline-block;
  color:var(--gold);
  background:rgba(217,196,106,.1);
  border:1px solid rgba(217,196,106,.25);
  padding:7px 12px;
  border-radius:999px;
  font-size:12px;
  font-weight:900;
  margin-bottom:18px;
}
.card{
  background:linear-gradient(180deg,var(--card2),var(--card));
  border:1px solid var(--line);
  border-radius:22px;
  padding:26px;
}
.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
.metric{background:rgba(255,255,255,.05);border:1px solid var(--line);border-radius:18px;padding:18px}
.metric strong{display:block;color:var(--cyan);font-size:34px}
textarea,input,select{
  width:100%;
  padding:14px;
  border-radius:14px;
  border:1px solid var(--line);
  background:#0c1513;
  color:white;
  margin-bottom:12px;
}
textarea{min-height:140px}
.founder{display:grid;grid-template-columns:320px 1fr;gap:28px;align-items:center}
.founder img{width:100%;border-radius:20px}
.report{background:white;color:#111;border-radius:16px;padding:26px}
.report p{color:#333}
footer{border-top:1px solid var(--line);padding:30px 0;color:var(--muted);font-size:14px}
@media(max-width:900px){
  .grid,.founder{grid-template-columns:1fr}
  .cards{grid-template-columns:1fr}
}
</style>
</head>

<body>

<header>
  <div class="container nav">
    <div class="logo">CLARITY SYSTEM · FLOW</div>
    <a class="btn primary" href="mailto:richardsy.028@gmail.com">Run FLOW Diagnosis</a>
  </div>
</header>

<section>
  <div class="container grid">
    <div>
      <div class="badge">Clarity System · Powered by FLOW</div>
      <h1>Turning chaos into operational execution.</h1>
      <p>
        Clarity FLOW helps businesses diagnose bottlenecks, build KPI systems,
        create SOPs, improve onboarding, and execute with COO-level clarity.
      </p>
      <br>
      <a class="btn primary" href="#diagnosis">Run Free Diagnosis</a>
      <a class="btn" href="#pricing">View Pricing</a>
    </div>

    <div class="card">
      <div class="badge">FLOW Operating Companion</div>
      <h2>Find. Link. Organize. Work.</h2>
      <p>
        FLOW identifies operational friction and turns it into clear priorities,
        KPI visibility, SOP structure, and execution next steps.
      </p>
      <br>
      <div class="metric">
        <p>Recommended next step</p>
        <strong>Deep Report</strong>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="badge">Industries</div>
    <h2>Four operating domains. One FLOW assistant.</h2>

    <div class="cards">
      <div class="card">
        <h3>Operation & Production</h3>
        <p>Workflow clarity, output tracking, SOPs, and execution control.</p>
      </div>
      <div class="card">
        <h3>Sales & Marketing</h3>
        <p>Real estate lead flow, CRM systems, campaigns, and follow-up SOPs.</p>
      </div>
      <div class="card">
        <h3>Healthcare & Pharmacy</h3>
        <p>Staff onboarding, admin flow, pharmacy coordination, and compliance SOPs.</p>
      </div>
      <div class="card">
        <h3>Education & Onboarding</h3>
        <p>Training systems, SOP videos, learner tracking, and onboarding flows.</p>
      </div>
    </div>
  </div>
</section>

<section id="diagnosis">
  <div class="container grid">
    <div class="card">
      <div class="badge">FLOW Free Diagnosis</div>
      <h2>Let FLOW diagnose the operating problem.</h2>

      <select id="industry">
        <option>Operation & Production</option>
        <option>Sales & Marketing / Real Estate</option>
        <option>Healthcare & Pharmacy</option>
        <option>Education & Onboarding</option>
      </select>

      <textarea id="problem" placeholder="Describe your business problem..."></textarea>

      <button class="btn primary" onclick="diagnose()">Generate Sample Diagnosis</button>
    </div>

    <div class="card">
      <h3>FLOW Sample Feedback</h3>
      <p id="feedback">
        Your sample diagnosis will appear here.
      </p>
      <br>
      <div class="metric">
        <p>Suggested next step</p>
        <strong id="nextStep">--</strong>
      </div>
    </div>
  </div>
</section>

<section id="pricing">
  <div class="container">
    <div class="badge">Pricing</div>
    <h2>Free FLOW diagnosis. Paid clarity system execution.</h2>

    <div class="cards">
      <div class="card">
        <h3>FLOW Free Diagnosis</h3>
        <h2>₱0</h2>
        <p>Basic AI diagnosis, sample insight, and high-level recommendation.</p>
        <br>
        <a class="btn" href="#diagnosis">Start Free</a>
      </div>

      <div class="card">
        <h3>FLOW Deep Diagnosis Report</h3>
        <h2>₱4,999</h2>
        <p>Custom diagnosis, KPI system, SOP priorities, onboarding gaps, and execution roadmap.</p>
        <br>
        <a class="btn primary" href="mailto:richardsy.028@gmail.com?subject=FLOW Deep Diagnosis Report">Unlock Report</a>
      </div>

      <div class="card">
        <h3>Premium Execution Sprint</h3>
        <h2>₱15K–₱30K</h2>
        <p>KPI dashboards, SOP videos, onboarding system, and workflow implementation.</p>
        <br>
        <a class="btn primary" href="mailto:richardsy.028@gmail.com?subject=FLOW Execution Sprint">Book Sprint</a>
      </div>

      <div class="card">
        <h3>Custom Consultation</h3>
        <h2>Custom</h2>
        <p>COO-level advice, approval guidance, prioritization, and strategy session.</p>
        <br>
        <a class="btn" href="mailto:richardsy.028@gmail.com?subject=FLOW Consultation">Contact Richard</a>
      </div>
    </div>
  </div>
</section>

<section>
  <div class="container">
    <div class="badge">Preview</div>
    <h2>AI-generated COO-level report preview.</h2>

    <div class="report">
      <h2>Clarity System Report</h2>
      <p><strong>Prepared by:</strong> FLOW Operating Companion</p>
      <hr><br>
      <p id="reportPreview">
        This preview shows how FLOW summarizes bottlenecks, KPI gaps,
        SOP priorities, onboarding issues, and execution next steps.
      </p>
      <br>
      <a class="btn primary" href="mailto:richardsy.028@gmail.com?subject=Paid Report Review">Contact Richard for Review</a>
    </div>
  </div>
</section>

<section>
  <div class="container founder card">
    <img src="founder.jpg" alt="Richard Sy">
    <div>
      <div class="badge">Founder</div>
      <h2>Built by Richard Sy.</h2>
      <p>
        Richard created Clarity System to help businesses turn chaos into order.
        FLOW is designed to diagnose operating problems, organize systems,
        and help teams execute with clarity.
      </p>
      <br>
      <a class="btn primary" href="mailto:richardsy.028@gmail.com">Email Richard</a>
      <a class="btn" target="_blank" href="https://www.linkedin.com/in/richard-sy-9b57b8242/?locale=tl">LinkedIn</a>
    </div>
  </div>
</section>

<footer>
  <div class="container">
    © 2026 Clarity System · FLOW by Richard Sy · richardsy.028@gmail.com
  </div>
</footer>

<script>
function diagnose(){
  const industry = document.getElementById("industry").value;
  const problem = document.getElementById("problem").value.trim();
  const feedback = document.getElementById("feedback");
  const next = document.getElementById("nextStep");
  const preview = document.getElementById("reportPreview");

  if(!problem){
    feedback.innerText = "Please describe your operating problem first.";
    next.innerText = "Describe Problem";
    return;
  }

  const message =
    "Sample FLOW Diagnosis for " + industry + ": The business likely has execution friction caused by unclear ownership, weak KPI visibility, undocumented SOPs, and inconsistent follow-through. Recommended action: define core KPIs, document the highest-friction workflow, assign ownership, and build a weekly execution rhythm.";

  feedback.innerText = message;
  next.innerText = "Unlock Deep Report";
  preview.innerText = message + " A paid FLOW report would include a deeper breakdown, KPI recommendations, SOP priorities, onboarding gaps, charts, and an execution roadmap.";
}
</script>

</body>
</html>
